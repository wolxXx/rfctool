{
  "name": "wolxxx/rfctool",
  "version": "0.1",
  "description": "app for managing rfcs",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "wolxXx",
      "email": "devops@wolxXx.de"
    }
  ],
  "support": {
    "email": "devops@wolxxx.de",
    "issues": "https://github.com/wolxXx/rfctool/issues"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true,
    "optimize-autoloader": true,
    "secure-http": false,
    "allow-plugins": {
      "mouf/nodejs-installer": true
    }
  },
  "scripts": {
    "paratest": "php scripts/prepareUnitTestDatabse.php && XDEBUG_MODE=coverage  ./vendor/bin/paratest  --configuration test/phpunit.xml --coverage-html test/coverage --coverage-clover test/coverage/coverage.clover --display-incomplete --display-skipped --display-deprecations --testdox",
    "paratestNoCoverage": "php scripts/prepareUnitTestDatabse.php && ./vendor/bin/paratest  --configuration test/phpunit.xml --display-incomplete --display-skipped --display-deprecations",
    "test": "php scripts/prepareUnitTestDatabse.php && XDEBUG_MODE=coverage  ./vendor/phpunit/phpunit/phpunit  --configuration test/phpunit.xml --coverage-html test/coverage --coverage-clover test/coverage/coverage.clover --display-incomplete --display-skipped --display-deprecations --testdox-html test/testdocs.html --testdox --cache-result",
    "testNoCoverage": "php scripts/prepareUnitTestDatabse.php && ./vendor/phpunit/phpunit/phpunit  --configuration test/phpunit.xml --testdox --cache-result",
    "npm": "cd public && ../vendor/bin/npm ci",
    "composerVendorPublic": "./install.sh",
    "css": "php vendor/bin/pscss public/css/app.scss public/css/app.css",
    "db": ["@dbSyncMetaData", "@listMigrations", "@executeMigrations", "@dbChanges"],
    "dbFull": ["@dbChanges", "@dbMigrateLazy", "@markMigrationsExecuted", "@dbSyncMetaData", "@fixtures"],
    "dbDry": ["@dbChanges", "@listMigrations"],
    "dbSyncMetaData": "./vendor/bin/doctrine-migrations migrations:sync-metadata-storage",
    "dbMigrateLazy": "php bin/doctrine orm:schema-tool:update --force --verbose",
    "dbChanges": "php bin/doctrine orm:schema-tool:update --dump-sql --verbose",
    "executeMigrations": "./vendor/bin/doctrine-migrations migrations:migrate --no-interaction --all-or-nothing",
    "listMigrations": "./vendor/bin/doctrine-migrations migrations:list",
    "generateMigration": "./vendor/bin/doctrine-migrations migrations:generate",
    "markMigrationsExecuted": "php scripts/markMigrationsExecuted.php",
    "fixtures": "php scripts/fixtures.php",
    "post-install-cmd": ["@npm", "@composerVendorPublic", "@css"],
    "post-update-cmd": ["@post-install-cmd"]
  },
  "autoload": {
    "psr-4": {
      "MyDMS\\": "src/",
      "MyDMSTest\\": "test/"
    }
  },

  "extra": {
    "mouf": {
      "nodejs": {
        "version": "22.*",
        "targetDir": "vendor/nodejs/nodejs",
        "forceLocal": true
      }
    }
  },
  "require": {
    "php": "8.4.*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "amphp/amp": "*",
    "aws/aws-sdk-php": "*",
    "beberlei/assert": "*",
    "beberlei/doctrineextensions": "*",
    "brianium/paratest": "*",
    "codeception/codeception": "*",
    "danhunsaker/flysystem-redis": "*",
    "doctrine/migrations": "*",
    "doctrine/orm": "*",

    "endroid/qr-code": "*",
    "ergebnis/phpunit-slow-test-detector": "*",
    "fakerphp/faker": "*",
    "fortawesome/font-awesome": "*",
    "friendsofphp/php-cs-fixer": "*",
    "gedmo/doctrine-extensions": "*",
    "google/apiclient": "*",
    "gumlet/php-image-resize": "*",

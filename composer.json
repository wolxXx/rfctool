{
  "name": "wolxxx/rfctool",
  "version": "0.1",
  "description": "app for managing rfcs",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "wolxXx",
      "email": "devops@wolxXx.de"
    }
  ],
  "support": {
    "email": "devops@wolxxx.de",
    "issues": "https://github.com/wolxXx/rfctool/issues"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true,
    "optimize-autoloader": true,
    "secure-http": false,
    "allow-plugins": {
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "scripts": {
    "paratest": "php scripts/prepareUnitTestDatabse.php && XDEBUG_MODE=coverage  ./vendor/bin/paratest -p 100  --configuration test/phpunit.xml --coverage-html test/coverage --coverage-clover test/coverage/coverage.clover --display-incomplete --display-skipped --display-deprecations --testdox",
    "paratestNoCoverage": "php scripts/prepareUnitTestDatabse.php && ./vendor/bin/paratest -p 100  --configuration test/phpunit.xml --display-incomplete --display-skipped --display-deprecations",
    "test": "php scripts/prepareUnitTestDatabse.php && XDEBUG_MODE=coverage  ./vendor/phpunit/phpunit/phpunit  --configuration test/phpunit.xml --coverage-html test/coverage --coverage-clover test/coverage/coverage.clover --display-incomplete --display-skipped --display-deprecations --testdox-html test/testdocs.html --testdox --cache-result",
    "testNoCoverage": "php scripts/prepareUnitTestDatabse.php && ./vendor/phpunit/phpunit/phpunit  --configuration test/phpunit.xml --testdox --cache-result",
    "lint": "./vendor/bin/parallel-lint --colors --short -j 100 --exclude vendor --blame --show-deprecated .",
    "lintVendor": "./vendor/bin/parallel-lint --colors --short -j 100 --exclude vendor/nikic/fast-route/test vendor",
    "stan": "vendor/bin/phpstan analyse src | tee stan.log",
    "stanDetailed": "vendor/bin/phpstan analyse src --level 6 | tee stan.log",
    "stanHeavy": "vendor/bin/phpstan analyse src --level 9 | tee stan.log",
    "composerVendorPublic": "./install.sh",
    "db": ["@dbSyncMetaData", "@dbChanges"],
    "dbFull": ["@dbChanges", "php bin/doctrine orm:schema-tool:update --force --verbose", "@dbValidateSchema", "@dbSyncMetaData"],
    "dbDry": ["@dbChanges"],
    "dbSyncMetaData": "./vendor/bin/doctrine-migrations migrations:sync-metadata-storage",
    "dbChanges": "php bin/doctrine orm:schema-tool:update --dump-sql --verbose",
    "dbValidateSchema": "php bin/doctrine orm:validate-schema --verbose",
    "rector": "./vendor/bin/rector",
    "post-install-cmd": ["@composerVendorPublic", "@health", "./composer.phar audit"],
    "post-update-cmd": ["@post-install-cmd"],
    "health": [
      "@paratestNoCoverage",
      "@stan",
      "@lint",
      "@lintVendor",
      "@validateSchema"
    ]
  },
  "autoload": {
    "psr-4": {
      "RfcTool\\": "src/",
      "RfcToolTest\\": "test/"
    }
  },
  "require": {
    "php": "8.5.*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "amphp/amp": "*",
    "aws/aws-sdk-php": "*",
    "beberlei/assert": "*",
    "beberlei/doctrineextensions": "*",
    "brianium/paratest": "*",
    "codeception/codeception": "*",
    "danhunsaker/flysystem-redis": "*",
    "doctrine/migrations": "*",
    "doctrine/orm": "*",
    "doctrine/sql-formatter": "*",
    "endroid/qr-code": "*",
    "ergebnis/phpunit-slow-test-detector": "*",
    "fakerphp/faker": "*",
